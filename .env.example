# Environment Configuration Template
PROJECT_NAME="Code Complexity Visualizer"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Primary / Production: Supabase PostgreSQL (psycopg driver)
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Local Development Fallback: SQLite
DATABASE_URL=sqlite+pysqlite:///./complexity.db

# Limits
MAX_CODE_LENGTH_BYTES=100000
MAX_CODE_LINES=3000
